<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @list.name %></h1>
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
  </div>

  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-12 col-md-3 mb-4">
        <div class="card h-100">
          <%= image_tag bookmark.movie.poster_url, class: "card-img-top" if bookmark.movie.poster_url %>
          <div class="card-body">
            <h5><%= bookmark.movie.title %></h5>
            <p class="text-muted">⭐ <%= bookmark.movie.rating %></p>
            <p><em>"<%= bookmark.comment %>"</em></p>
            <%= link_to "Remove", bookmark_path(bookmark),
                  data: { turbo_method: :delete, turbo_confirm: "Remove this movie?" },
                  class: "btn btn-outline-danger btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "← Back to lists", lists_path %>
</div>
